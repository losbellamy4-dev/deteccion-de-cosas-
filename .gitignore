# sin conexión, elimina estas líneas (o usa Git LFS).
lib/*
!lib/README.md
models/*
!models/README.md

# Descargas a medias del script
*.part

# Varios
node_modules/
__pycache__/
.DS_Store
Thumbs.db
*.log

# HTML portable generado por tools/construir_portable.py (≈ 50 MB)
dist/
